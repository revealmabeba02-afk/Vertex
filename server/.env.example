# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit your real API key.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for chart analysis (must support vision/image input)
CLAUDE_MODEL=claude-sonnet-5

# Port the backend server listens on
PORT=3000

# Max upload size in megabytes (raw file, before base64 encoding).
# Anthropic's direct API hard limit is 10MB for the base64-encoded image,
# and base64 adds ~33% overhead, so keep this at 7 or below to stay safe.
MAX_UPLOAD_MB=7

# Comma-separated list of origins allowed to call this API.
# For local dev the default below is fine. In production, set this to
# your actual frontend origin(s), e.g. https://yourapp.com
CORS_ORIGIN=http://localhost:3000

# Supabase (accounts). Project Settings > API in the Supabase dashboard.
# Use the Project URL and the anon / public key ONLY.
# Never put the service_role key here or anywhere in this project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Pay-per-scan credits (Binance Pay). See supabase/credits_setup.sql for the
# full setup. BINANCE_API_KEY/SECRET must be a READ-ONLY key (Account > API
# Management, only "Enable Reading" turned on) — never a key with trading or
# withdrawal permissions.
BINANCE_API_KEY=your-read-only-binance-api-key
BINANCE_API_SECRET=your-read-only-binance-api-secret
BINANCE_PAY_ID=1283803211
# Must exactly match the secret baked into supabase/credits_setup.sql.
# This file is committed to the repo, so do NOT put the real secret here —
# set the real value only in Render's environment variables.
CREDIT_FULFILL_SECRET=replace-with-the-same-secret-as-credits_setup.sql

# Optional: powers AI triage on the support inbox (auto-answers simple
# questions, drafts the rest for you to review). Without this, support
# messages still work fine, just with no AI reply/suggestion.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pay-per-scan credits via Whop (replaces Binance Pay — Binance's API blocks
# requests from Render's server region). See supabase/whop_setup.sql.
# WHOP_WEBHOOK_SECRET: from Whop dashboard > Developer > Webhooks, the
# "Secret" shown for the webhook pointed at /api/webhooks/whop (starts with
# ws_). This file is committed to the repo — never put the real value here,
# only in Render's environment variables.
WHOP_WEBHOOK_SECRET=replace-with-the-real-whop-webhook-secret
# Optional, not required for payments to work — reserved for future use.
WHOP_API_KEY=your-whop-api-key
