# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit your real API key.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for chart analysis (must support vision/image input)
CLAUDE_MODEL=claude-sonnet-5

# Port the backend server listens on
PORT=3000

# Max upload size in megabytes (raw file, before base64 encoding).
# Anthropic's direct API hard limit is 10MB for the base64-encoded image,
# and base64 adds ~33% overhead, so keep this at 7 or below to stay safe.
MAX_UPLOAD_MB=7

# Comma-separated list of origins allowed to call this API.
# For local dev the default below is fine. In production, set this to
# your actual frontend origin(s), e.g. https://yourapp.com
CORS_ORIGIN=http://localhost:3000

# Supabase (accounts). Project Settings > API in the Supabase dashboard.
# Use the Project URL and the anon / public key ONLY.
# Never put the service_role key here or anywhere in this project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Pay-per-scan credits (Binance Pay). See supabase/credits_setup.sql for the
# full setup. BINANCE_API_KEY/SECRET must be a READ-ONLY key (Account > API
# Management, only "Enable Reading" turned on) — never a key with trading or
# withdrawal permissions.
BINANCE_API_KEY=your-read-only-binance-api-key
BINANCE_API_SECRET=your-read-only-binance-api-secret
BINANCE_PAY_ID=1283803211
# Must exactly match the secret baked into supabase/credits_setup.sql.
# This file is committed to the repo, so do NOT put the real secret here —
# set the real value only in Render's environment variables.
CREDIT_FULFILL_SECRET=replace-with-the-same-secret-as-credits_setup.sql

# Optional: powers AI triage on the support inbox (auto-answers simple
# questions, drafts the rest for you to review). Without this, support
# messages still work fine, just with no AI reply/suggestion.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pay-per-scan credits via Whop (replaces Binance Pay — Binance's API blocks
# requests from Render's server region). See supabase/whop_setup.sql.
# WHOP_WEBHOOK_SECRET: from Whop dashboard > Developer > Webhooks, the
# "Secret" shown for the webhook pointed at /api/webhooks/whop (starts with
# ws_). This file is committed to the repo — never put the real value here,
# only in Render's environment variables.
WHOP_WEBHOOK_SECRET=replace-with-the-real-whop-webhook-secret
# Optional, not required for payments to work — reserved for future use.
WHOP_API_KEY=your-whop-api-key
# Optional: override any of the 4 bundles' checkout links without a redeploy.
# The real values already work without setting these.
WHOP_CHECKOUT_QUICK=https://whop.com/shadowfx-1eca/quick-5e/
WHOP_CHECKOUT_STARTER=https://whop.com/shadowfx-1eca/starter-20-scans
WHOP_CHECKOUT_TRADER=https://whop.com/shadowfx-1eca/trader-60-scans
WHOP_CHECKOUT_PRO=https://whop.com/shadowfx-1eca/pro-150-scans

# "Name your price" custom top-up (any amount from $5). Unlike the 4 bundles
# above, this one has to be priced at the moment someone picks it, so it uses
# the Whop API instead of a static checkout link. Get WHOP_API_KEY from
# Whop dashboard > Settings > API Keys (this IS required now, not optional
# like it was before). WHOP_CUSTOM_PRODUCT_ID is the product these one-off
# plans get attached to — any existing Whop product's id works (from its
# dashboard page, or the 3-dot menu), or make a new hidden one just for this.
# Without both of these set, the custom-amount box still shows but tells
# people it's not ready yet — the 4 bundles keep working either way.
WHOP_CUSTOM_PRODUCT_ID=prod_xxxxxxxxxxxx

# Social link tracking — /go/tiktok, /go/instagram, /go/youtube, /go/facebook
# redirect to the real profiles below, log the click, and email an alert.
# Requires supabase/link_clicks.sql to have been run.
# RESEND_API_KEY: free account at https://resend.com -> API Keys. Without
# this set, clicks still log and redirect fine, just no email fires.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where the click alert emails go.
LINK_ALERT_EMAIL=revealmabeba02@icloud.com
# Must be on a domain verified with Resend. Their shared onboarding@resend.dev
# address works out of the box for any destination until you verify your own.
LINK_ALERT_FROM=Vertex Scanner <onboarding@resend.dev>
# Optional: override any of the 4 destination profiles without a redeploy.
# The real values already work without setting these.
SOCIAL_LINK_TIKTOK=https://www.tiktok.com/@verxter6
SOCIAL_LINK_INSTAGRAM=https://instagram.com/verte.x6
SOCIAL_LINK_YOUTUBE=https://www.youtube.com/@Vertex06
SOCIAL_LINK_FACEBOOK=https://www.facebook.com/share/1EGMWwPbXv/

# Optional extra lock in front of /admin, on top of the real admin-email
# check that already gates every /api/admin/* call. Leave unset to turn the
# PIN screen off entirely. Pick any digits/letters you like.
ADMIN_PIN=

# --- Market watcher -------------------------------------------------------
# The loop behind the Watcher tab. Every read it makes is a real provider
# call, so the defaults are deliberately frugal: three majors, one timeframe,
# once every half hour, during market hours only, with a hard daily ceiling
# that closes the loop instead of draining the plan.
#
# WATCH_ENABLED=true turns the loop on at boot. Set to false to keep the tab
# (and /api/watch/tick) available without any background spend.
WATCH_ENABLED=true
# Comma-separated symbols and timeframes. 3 symbols x 1 timeframe x every
# 30 min x ~48 market-hours windows a day is the shape of the cost.
WATCH_SYMBOLS=EURUSD,XAUUSD,US30
WATCH_TIMEFRAMES=H1
# How often to re-read, in ms. 1800000 = 30 minutes.
WATCH_INTERVAL_MS=1800000
# Hard ceiling on provider reads per UTC day. When it is hit the watcher
# stops until midnight UTC and the feed says so.
WATCH_MAX_CALLS_PER_DAY=120
# Set true to keep watching outside FX hours (crypto/indices holidays).
WATCH_IGNORE_HOURS=false

# --- Growth agent -----------------------------------------------------------
# The marketing brain (admin > Growth). Uses GEMINI_API_KEY with the Google
# Search grounding tool, so it researches online on the free tier. Runs are
# admin-triggered only, never automatic.
#
# Optional overrides:
GROWTH_MODEL=gemini-3.8-flash
GROWTH_MAX_RUNS_PER_DAY=10

# --- Notifications (how the agents reach you) -------------------------------
# Every pipe below is independent. Leave a block commented out and it simply
# does not exist; the agent sends through whatever is configured. Email is the
# default and needs nothing new (RESEND_API_KEY is already set).
#
# NOTE for email: with the onboarding@resend.dev sender, Resend only delivers
# to the address the Resend account itself is registered under unless a domain
# is verified on resend.com/domains. That is why ADMIN_EMAIL is the target.
ALERT_EMAIL=revealmabeba02@gmail.com
MONEY_BRIEF_AI=true

# ntfy - no account, no phone, no app required for testing: pick a topic name,
# open https://ntfy.sh/<topic> in a browser, and every message shows up there.
# The topic name is the only secret, so make it long and random.
# NTFY_TOPIC=vertex-alerts-<random-words>
# NTFY_URL=https://ntfy.sh
# Optional: an access token from a free ntfy account. Not needed while the topic
# is open, but without it, locking the topic later would silently stop delivery.
# NTFY_TOKEN=tk_...
# 001 answers inside /admin. The ntfy topic is a one-way pager by default:
# alerts go out, nothing typed there is read. Set this to a number of ms to let
# him answer messages on the topic too (not recommended while it is public).
# INBOX_POLL_MS=30000
# Answers per hour. The free model quota is shared with the product's own AI,
# so the chat has a budget and says so instead of going silent.
# INBOX_MAX_PER_HOUR=10

# Discord - Server Settings > Integrations > Webhooks > New Webhook > Copy URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram - needs a bot token from @BotFather, which needs a Telegram account,
# which needs a phone number to register. Set both to turn it on.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# --- Payments: PayPal -------------------------------------------------------
# PayPal.Me needs no API key and no webhook: create a PayPal account on the
# address above, claim the handle at paypal.com/paypalme, and put it here.
# The credits panel then shows "Pay with PayPal" as a second option, and each
# claim emails you so you can confirm the order in /admin.
# PAYPAL_ME_HANDLE=yourhandle

# --- Agent money reader -----------------------------------------------------
# Lets 001 read the same revenue summary the dashboard shows, without a login.
# Requires supabase/agent_money.sql to have been run first; the value here and
# the value in that file must be identical, or every read is refused.
# This is NOT a database key: it only unlocks a read-only totals function.
# AGENT_MONEY_SECRET=48-random-hex-characters
# Hour (UTC) the daily money brief goes out. 17 = 19:00 South Africa time.
# MONEY_BRIEF_HOUR_UTC=17

# --- Ops agent --------------------------------------------------------------
# Reads health, memory, logs and deploys; can restart (max 2/hour). The reflex
# layer runs with no model call and only escalates to the model when something
# looks wrong, so a free Gemini key survives.
OPS_AGENT_ENABLED=true
OPS_INTERVAL_MS=900000
OPS_RESTART_LIMIT=2
